# Copy to .env (git-ignored) or export in your shell.
MAS_DATABASE_URL=postgresql://mas:mas@localhost:5432/mas
MAS_PG_PORT=5432

# Runtime paths / images
MAS_DATA_DIR=./.mas
MAS_VERIFIER_IMAGE=mas-verifier:latest

# Worker and orchestrator (compose / `mas up`)
MAS_WORKER_CAPABILITIES=architecture,implementation,testing,integration,solve
MAS_WORKER_POLL_S=0.5
MAS_WORKER_AGENT=llm
MAS_ORCH_PLANNER=llm
MAS_ORCH_VERIFIER=external
MAS_EXEC_BACKEND=remote

# The gateway is the only Compose service that receives a vendor credential.
# Pick ONE real upstream and inject its key into the shell before `mas up --build`.
MAS_GATEWAY_UPSTREAM=anthropic:YOUR_MODEL
MAS_GATEWAY_MODELS=builder
MAS_GATEWAY_TOKEN=replace-with-a-random-local-token
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Workers and the planner address the gateway using allowed logical model names.
MAS_MODEL_WORKER=openai:builder
MAS_MODEL_PLANNER=openai:builder

# USD per 1M tokens. Use exact/current prices for the real upstream; unpriced calls are reported as cost unknown.
# MAS_MODEL_PRICES={"YOUR_MODEL":{"input":0,"output":0}}

# Optional direct-host provider settings (`mas run` / scripts/live_smoke.py)
# MAS_OPENAI_BASE_URL=https://api.openai.com/v1
# MAS_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
