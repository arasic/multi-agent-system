# Copy to .env (git-ignored) or export in your shell.
MAS_DATABASE_URL=postgresql://mas:mas@localhost:5432/mas
MAS_PG_PORT=5432

# Worker (compose / `mas worker`)
MAS_WORKER_CAPABILITIES=architecture,implementation,testing,integration,solve
MAS_WORKER_POLL_S=0.5

